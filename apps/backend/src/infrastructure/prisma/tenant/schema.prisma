// ─────────────────────────  Per-tenant schema  ─────────────────────────
//
// Every model here is created once per municipality, inside that municipality's
// own Postgres schema (tenant_ashrafieh, tenant_zahle, ...). There is no
// `tenantId` column anywhere: the schema IS the tenant boundary. A query cannot
// read another municipality's rows because the connection is not pointed at
// that schema — not because a WHERE clause remembered to filter.
//
// Migrations here are applied to EVERY tenant schema by `migrate-all-tenants.ts`.
// Adding a model is therefore an O(tenants) operation, which is a loop at this
// scale and a reason to revisit only in the hundreds.

generator client {
  provider      = "prisma-client-js"
  output        = "../../../generated/tenant-client"
  /// "native" is the local dev machine; "rhel-openssl-3.0.x" is Vercel's
  /// Amazon Linux 2023 runtime. The query engine is a platform-specific binary,
  /// so a client generated without the deployment target loads fine at build
  /// time and then throws at the first query with "Query engine library for
  /// current platform could not be found".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────  Identity  ──────────────────────────────

/// Staff and citizens are one table with one JWT format and one guard.
/// Splitting them was how v1 ended up writing every tenant check twice.
enum UserKind {
  STAFF
  CITIZEN
}

enum StaffRole {
  SUPER_ADMIN
  AUDITOR
  FIELD_INSPECTOR
  COLLECTOR
  ACCOUNTANT
  ADMINISTRATIVE_OFFICER
}

enum Gender {
  MALE
  FEMALE
}

/// صفة الإقامة — classifies the person, never the property.
enum ResidentStatus {
  REFUGEE
  DISPLACED
  VILLAGE_RESIDENT
}

/// الحالة الاجتماعية — asked in step 2 alongside the rest of the household picture.
enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum IdentityDocType {
  NATIONAL_ID
  FAMILY_RECORD
  DRIVER_LICENSE
  PASSPORT
}

model User {
  id   String   @id @default(uuid()) @db.Uuid
  kind UserKind

  /// Denormalised copy of the owning municipality's slug. Redundant with the
  /// schema itself, but it means a JWT's `tenantSlug` can be checked against the
  /// row it claims to authenticate — defence in depth against a factory bug
  /// handing out the wrong client.
  tenantSlug String

  // ── Staff-only ──
  email           String?
  passwordHash    String?
  role            StaffRole?
  /// Base32 TOTP secret. Mandatory for SUPER_ADMIN before any session is issued.
  totpSecret      String?
  totpConfirmedAt DateTime?

  // ── Citizen-only ──
  phone    String?
  whatsapp String?

  firstName  String
  middleName String?
  lastName   String
  gender     Gender?

  nationality       String?
  isLebanese        Boolean?
  residencyNumber   String?
  residentStatus    ResidentStatus?
  identityDocType   IdentityDocType?
  identityDocNumber String?
  civilRecordNumber String?
  totalRegisteredMembers Int?
  actualHouseholdMembers Int?
  maritalStatus     MaritalStatus?
  bloodType         BloodType?

  /// رقم مرجعي — usable when a phone is lost or shared.
  referenceNumber String? @unique

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  /// Bumped to revoke every session this account holds, at once.
  ///
  /// Stamped into the JWT and compared on every authenticated request. Without
  /// it there was no revocation at all: role travels in the token and
  /// `RolesGuard` reads it from there, so a dismissal or a demotion took effect
  /// only when the token expired — up to 30 days for "تذكّرني على هذا الجهاز".
  /// Deactivation, reactivation, a role change and a password change all bump
  /// this.
  tokenVersion Int @default(0)

  /// The TOTP step a code was last accepted at, making each code single-use.
  ///
  /// `otplib` runs with `window: 1`, so the same six digits verify for about
  /// ninety seconds — long enough for an observed code to be replayed. A login
  /// presenting a step at or below this one is refused whatever the digits say.
  lastTotpStep BigInt?

  /// Read-only. A Postgres `GENERATED ALWAYS AS ... STORED` column holding
  /// every value this row can be looked up by, folded to one alphabet:
  /// hamza-carrying alefs to bare alef, taa marbuta to haa, alef maqsura to
  /// yaa, tashkeel stripped, Arabic-Indic digits to Latin, every separator to
  /// a space — plus a second, space-free copy of each identifier so a
  /// reference number typed without its dashes still matches.
  ///
  /// **Never write to it.** The database computes it and rejects any INSERT or
  /// UPDATE that supplies a value. It is optional here only because Prisma
  /// omits an absent optional field from the statement it builds, which is the
  /// one way to model a generated column in a schema language that has no
  /// word for one. Declared so it can be *filtered* on; see
  /// `searchTokens` in application/common/search-terms.ts for the matching
  /// query side, and migration 0018 for the definition.
  searchText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations         Registration[]
  reviewedRegistrations Registration[]       @relation("ReviewedBy")
  payments              CitizenPayment[]
  reviewedPayments      CitizenPayment[]     @relation("PaymentReviewedBy")
  collectedPayments     CitizenPayment[]     @relation("PaymentCollectedBy")
  collectedTransactions PaymentTransaction[] @relation("TransactionCollectedBy")
  recordedTransactions  PaymentTransaction[] @relation("TransactionRecordedBy")
  targetedFeeNotices    FeeNotice[]          @relation("FeeTargetCitizen")
  issuedFeeNotices      FeeNotice[]          @relation("FeeIssuedBy")
  createdRegistrations  Registration[]       @relation("RegistrationCreatedBy")
  inspectorPayouts      InspectorPayout[]    @relation("InspectorPayouts")
  recordedInspectorPayouts InspectorPayout[] @relation("RecordedInspectorPayouts")
  createdCases          Case[]               @relation("CaseCreatedBy")
  resolvedCases         Case[]               @relation("CaseResolvedCitizen")

  /// Staff email is unique within the municipality (i.e. within this schema).
  @@unique([email])
  /// A household commonly shares one phone, so phone alone is not unique; the
  /// identity document is what distinguishes people. See the open question in
  /// docs/open-decisions.md about tolerating near-duplicate name spellings.
  @@unique([identityDocType, identityDocNumber])
  @@index([kind, phone])
  @@index([kind, role])
  @@map("users")
}

/// Short-lived phone-OTP challenges. Rows are disposable; a cleanup job prunes
/// expired ones so a stale code can never be replayed.
model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  /// bcrypt hash — a leaked table must not hand out live login codes.
  codeHash   String
  /// Which delivery route issued it, so a failing provider is visible in data
  /// rather than only in logs. See the OTP fallback requirement in Section 10.
  channel    String    @default("PRIMARY")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

// ────────────────────────────  Registration  ────────────────────────────

enum ReportStatus {
  PENDING

  /// Filed with named fields left unestablished — see `flaggedFields`. Not a
  /// rejection and not a draft: the citizen is registered, searchable and
  /// billable from the moment the row exists.
  REQUIRES_REVIEW

  UNDER_REVIEW
  VERIFIED
  APPROVED
  REJECTED
}

model Registration {
  id        String       @id @default(uuid()) @db.Uuid
  citizenId String       @db.Uuid
  citizen   User         @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  status    ReportStatus @default(PENDING)

  referenceNumber String  @unique
  rejectionReason String?

  /// Which specific fields the reviewer flagged as wrong, as dot-paths the
  /// applicant's form can resolve back to an input — `personal.firstName`, or
  /// `property.0.propertyNumber` for a repeated card. Empty on a whole-claim
  /// rejection, which stays a valid outcome: not every refusal is a
  /// correctable mistake.
  ///
  /// Denormalised onto the registration rather than a join table because it
  /// is read as one blob (render the applicant's form) and written as one
  /// blob (the reviewer submits the whole set at once) — a row per flag would
  /// buy queryability nothing here asks for.
  rejectedFields String[] @default([])

  /// «غير مؤكَّد / بانتظار المعلومة» — the fields a field officer could not
  /// establish, each with the reason they gave, as
  /// `[{ "path": "personal.civilRecordNumber", "reason": "…" }]`.
  ///
  /// Paths are the dot-paths `rejectedFields` already uses and the ones the
  /// form resolves back to an input, so a stored flag renders beside the field
  /// it excuses without a second mapping. Non-empty here is exactly what
  /// `status = REQUIRES_REVIEW` means; the two are always written together.
  ///
  /// Json rather than a join table, for the reason stated just above: written
  /// once when the record is filed, read whole when someone opens it to finish.
  flaggedFields Json @default("[]")

  /// The browser's own name for the submission that created this row.
  ///
  /// Minted before the record is ever sent, so it survives being queued in
  /// IndexedDB on a phone with no signal and travels with every retry. Unique,
  /// which is what makes syncing safe to repeat: a submission whose response
  /// was lost to the same bad connection that queued it is recognised on
  /// arrival and answered with the registration it already created, rather than
  /// registering the person a second time. Null for anything filed online.
  clientSubmissionId String? @unique

  /// Whether the citizen may fix the flagged fields themselves.
  ///
  /// Default true: a wrong digit is a wrong digit, and making someone travel
  /// to the municipality to change one is the outcome this system exists to
  /// avoid. False is the deliberate exception — an original document has to be
  /// seen, or an identity verified in person — and it turns the citizen's
  /// correction form into an instruction to visit instead.
  citizenCanCorrect Boolean @default(true)

  /// Optional appointment for that visit. Only meaningful when
  /// `citizenCanCorrect` is false; null there simply means "come when you can".
  revisitAt DateTime?

  createdById  String?   @db.Uuid
  createdBy    User?     @relation("RegistrationCreatedBy", fields: [createdById], references: [id])

  reviewedById String?   @db.Uuid
  reviewedBy   User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  properties PropertyEntry[]
  documents  Document[]

  @@index([status, submittedAt])
  @@index([citizenId])
  @@index([createdById])
  @@map("registrations")
}

enum OccupancyType {
  OWNER
  TENANT
  /// شاغل بتسامح — living in someone else's property without paying بدل.
  ///
  /// A son in his father's flat, a caretaker in the owner's ground floor. Not
  /// a مالك (no deed) and not a مستأجر (no lease, no rent), and recording them
  /// as the latter — the only prior option — writes a tenancy into the register
  /// that does not exist. They are still the شاغل, so the occupancy fees fall
  /// on them and the owner still has to be named; what differs is that there is
  /// no عقد إيجار to attach and frequently no phone for the relative involved.
  FREE_OCCUPANT
}

/// حالة الوحدة — about the unit, never the person. See OccupancyType above,
/// which is «شاغل» to this enum's «شاغر»: one Arabic dot apart, and describing
/// opposite things.
///
/// Nullable everywhere it appears, and null is *not* vacancy — it is a unit
/// nobody was asked about. Reading the absence as empty would exempt every row
/// written before this column existed, which is silent under-collection of the
/// kind the per-unit assessment already refuses to commit.
enum UnitStatus {
  OWNER_OCCUPIED
  /// Occupied under a lease. The value that lets a landlord's building and a
  /// tenant's own card describe the same flat without both being charged for it.
  RENTED
  VACANT
  UNDER_CONSTRUCTION
}

enum PropertyType {
  BUILDING
  HOUSE
  LAND
  TENT
}

/// What one unit inside a parcel is. Wider than the original three because a
/// per-unit fee rate can only distinguish what this enum distinguishes — a
/// محل and a مستودع sharing a value means the municipality cannot charge them
/// differently even where its own schedule of fees does.
enum UnitType {
  APARTMENT
  INDEPENDENT_HOUSE
  CLINIC
  OFFICE
  SHOP
  WAREHOUSE
}

enum LandType {
  AGRICULTURAL
  INDUSTRIAL
}

/// One row per property card. A citizen may register many.
model PropertyEntry {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @db.Uuid
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  occupancyType OccupancyType
  landlordName  String?
  landlordPhone String?

  propertyType   PropertyType
  /// الحي — common to every property type. Free text: unlike رقم العقار there is
  /// no neighbourhood layer in the cadastre to check it against.
  ///
  /// Nullable only so it can hold the absence a «غير مؤكَّد» flag records.
  /// `propertyEntrySchema` still requires it of every card filed without one.
  neighborhood   String?
  /// رقم العقار as printed on the deed. Deliberately NOT unique: an apartment
  /// building is one cadastral number shared by every owner and tenant inside
  /// it, so co-registration is the normal case. Uniqueness here used to tell the
  /// second resident of a building that their own address was already taken.
  ///
  /// Nullable for the same reason الحي is, and it is the commoner of the two in
  /// practice: the deed is with a relative in another town, or the settlement
  /// has no cadastral number at all. A null one is simply absent from the
  /// cadastre lookup rather than matching nothing.
  propertyNumber String?
  /// unitType/floor/side/unitArea/sharedRights describe a single unit, which is
  /// all a HOUSE or a LAND ever has. A BUILDING reads its units from
  /// `units` instead — see BuildingUnit.
  unitType       UnitType?
  landType       LandType?
  buildingName   String?
  floor          String?
  side           String?
  tentLocation   String?
  unitArea       Decimal?     @db.Decimal(12, 2)
  /// أسهم — fractional land ownership, out of the Lebanese cadastre's standard
  /// 2400-share parcel. LAND only; null for every other نوع العقار.
  shares         Int?
  sharedRights   String[]     @default([])
  /// Asked of an OWNER filing a منزل, and null for every other card: a مستأجر
  /// or a شاغل بتسامح is the occupant of what they are filing, so there is no
  /// question to put to them. A مبنى reads its units' statuses instead.
  unitStatus     UnitStatus?

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
  units     BuildingUnit[]

  @@index([propertyType])
  @@index([propertyNumber])
  @@index([latitude, longitude])
  @@map("property_entries")
}

/// One unit inside a BUILDING — شقة, عيادة or محل.
///
/// Owning a whole building is one عقار with many units, not many عقارات: the
/// parcel has a single رقم العقار, and `PropertyEntry.propertyNumber` is unique
/// precisely so the cadastre lookup can trust it. Units therefore hang off the
/// parcel rather than duplicating it.
model BuildingUnit {
  id              String        @id @default(uuid()) @db.Uuid
  propertyEntryId String        @db.Uuid
  propertyEntry   PropertyEntry @relation(fields: [propertyEntryId], references: [id], onDelete: Cascade)

  unitType     UnitType
  floor        String
  side         String?
  unitArea     Decimal  @db.Decimal(12, 2)
  sharedRights String[] @default([])
  /// Set by the building's owner, unit by unit. Null on a tenant's own card.
  unitStatus   UnitStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyEntryId])
  @@map("building_units")
}

// ────────────────────────────  Cadastre  ────────────────────────────

/// The municipality's official parcel registry (رقم العقار), imported from the
/// survey office's KMZ by `cadastre:import`.
///
/// This is what makes رقم العقار checkable instead of merely well-formed: a
/// number either exists in the municipality's cadastre or it does not, and the
/// citizen finds out while typing rather than three weeks later when a clerk
/// cannot locate the property.
///
/// It also replaces the citizen-facing location picker. The parcel already has
/// authoritative coordinates from the survey, so asking someone to drop a pin on
/// a satellite image only invites a worse answer to a question already answered.
///
/// A municipality with no rows here keeps the old behaviour — any well-formed
/// number is accepted — so tenants can onboard before their cadastre is ready.
model Parcel {
  id String @id @default(uuid()) @db.Uuid

  /// As printed on the deed. Unique within this municipality, which the schema
  /// boundary already guarantees.
  parcelNumber String @unique

  /// Representative point for the parcel. Where the source drew a parcel with
  /// several label points, this is their centroid.
  latitude  Float
  longitude Float

  /// How many source points were merged into the centroid above. > 1 means the
  /// survey split this parcel, so the point is an approximation of a shape that
  /// is not contiguous.
  pointCount Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
  @@map("parcels")
}

/// An administrative sector (قطاع) the municipality draws over its own cadastre.
///
/// Unlike the parcel registry above, this is the municipality's own construct
/// rather than the survey office's: staff group parcels into sectors to assign
/// field inspectors, report registration coverage per area, and filter the map
/// down to a neighbourhood. Nothing outside the municipality knows these exist.
///
/// Membership is stored as the parcel *numbers* rather than as a relation to
/// `Parcel`. A cadastre re-import rebuilds the parcel table wholesale (see
/// `cadastre:import`), which would cascade away every zone's contents on a
/// routine survey correction. Parcel numbers are what the deed prints and what
/// staff actually type, so keeping them here lets a zone outlive the re-import
/// and simply reference a number the new cadastre may or may not still carry.
model Zone {
  id String @id @default(uuid()) @db.Uuid

  /// Free text as the municipality words it, e.g. "المنطقة الشرقية - قطاع أ".
  name String

  /// Short handle staff use in conversation and reports, e.g. "SEC-A1".
  code String @unique

  /// Hex fill this zone draws with on the map, `#RRGGBB`. Validated in the zone
  /// schema rather than by a Postgres type, matching how tenant branding colours
  /// are handled in the registry.
  color String @default("#3B82F6")

  description String?

  /// The رقم العقار values belonging to this zone. A number may appear in only
  /// one zone at a time; the service enforces that, since Postgres cannot
  /// express uniqueness across the elements of an array.
  parcelNumbers String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("zones")
}

/// OPEN still needs a revisit; RESOLVED means staff consider the situation
/// settled (a citizen was registered there, or the site is confirmed
/// permanently vacant/inaccessible). Resolving is a staff judgment call, not
/// a derived fact — nothing here links back to a citizen record.
enum CaseStatus {
  OPEN
  RESOLVED
}

/// A field visit that could not become a citizen registration — nobody was
/// home, the gate was locked, access was refused — so whatever staff could
/// observe from outside is recorded here instead of being lost before the
/// next visit.
///
/// Not a Registration or a PropertyEntry: at the moment it is logged there is
/// no citizen to attach either to. `resolvedCitizenId` is the bridge back —
/// set once someone (this visit or a later one) does register the resident,
/// so a case's outcome is traceable and a conversion rate is something this
/// table can actually answer rather than something kept in someone's head.
model Case {
  id String @id @default(uuid()) @db.Uuid

  /// What staff observed or why the visit didn't complete. Free text rather
  /// than a fixed reason list — "nobody home", "refused", "gate locked,
  /// dog in yard" don't compress into an enum without losing the detail the
  /// next visit needs.
  notes String

  propertyNumber String?
  neighborhood   String?
  propertyType   PropertyType?
  /// BUILDING/HOUSE only — which structure, and which floor for a BUILDING.
  buildingName   String?
  floor          String?
  /// HOUSE only — orientation.
  side           String?
  /// LAND only.
  landType       LandType?
  /// TENT only — free text, matching a citizen's own registration.
  tentLocation   String?

  status CaseStatus @default(OPEN)

  /// The citizen whose registration resolved this case — set by staff, either
  /// right after registering them (the common path, from `cases/[id]/register`)
  /// or after the fact by searching the registry (the case was logged Monday,
  /// the citizen turned up in someone else's registration Friday). Null does
  /// not mean unresolved: a case can also close as "confirmed vacant" or
  /// "refused" with nobody to link. Setting this always implies RESOLVED;
  /// clearing it does not imply the reverse.
  resolvedCitizenId String?   @db.Uuid
  resolvedCitizen   User?     @relation("CaseResolvedCitizen", fields: [resolvedCitizenId], references: [id], onDelete: SetNull)
  resolvedAt        DateTime?

  createdById String? @db.Uuid
  createdBy   User?   @relation("CaseCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([propertyNumber])
  /// Declared so Prisma knows about the index 0029 created; without it a later
  /// `migrate dev` reads the index as drift and proposes dropping it.
  @@index([resolvedCitizenId])
  @@map("cases")
}

enum DocumentType {
  IDENTITY
  OWNERSHIP_PROOF
  RENTAL_CONTRACT
  RESIDENCY_PROOF
  EXTRA_PHOTO
}

model Document {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @db.Uuid
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  /// Null for person-level documents (identity); set for per-property proofs.
  propertyEntryId String?        @db.Uuid
  propertyEntry   PropertyEntry? @relation(fields: [propertyEntryId], references: [id], onDelete: Cascade)

  type        DocumentType
  storagePath String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime     @default(now())

  @@index([registrationId])
  @@map("documents")
}

// ──────────────────────────────  Audit  ──────────────────────────────

/// Append-only. Nothing in the application layer updates or deletes these rows;
/// a per-schema trigger (see the tenant migration) enforces that at the DB level
/// so a future bug cannot quietly rewrite history.
model AuditLogEntry {
  id String @id @default(uuid()) @db.Uuid

  actorId    String?    @db.Uuid
  actorType  String     @default("STAFF")
  actorRole  StaffRole?
  actorEmail String?

  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_log_entries")
}

// ──────────────────────────  Fees & payments  ──────────────────────────

/// Municipality-wide configuration a clerk can change without a deploy.
///
/// A single row per tenant, enforced by `singleton` rather than by convention:
/// two rows would mean two Whish numbers, and the citizen portal would have no
/// way to know which one to print on the payment instructions.
model SystemSettings {
  id String @id @default(uuid()) @db.Uuid

  /// Guaranteed unique, so `upsert` always targets the same row.
  singleton Boolean @unique @default(true)

  /// The number citizens transfer to. Nullable because a municipality that has
  /// not set one yet must not have the portal invent a plausible-looking one —
  /// the Whish option is hidden instead.
  whishMoneyNumber String?

  /// Shown beside the "pay at the municipality" option. Free text: opening
  /// hours are a local arrangement, not something to model.
  cashOfficeHours   String?
  cashOfficeAddress String?

  /// The municipality's public landline/mobile, printed on receipts.
  contactPhone String?

  /// The office WhatsApp account.
  ///
  /// Printed on the receipt as the number a citizen may reply to, and shown on
  /// the settings screen as the account a clerk should be signed into before
  /// sending one. It cannot *make* a `wa.me` link send from this number —
  /// no link can; the sender is whichever account the browser is signed into.
  whatsappNumber String?

  // ── Municipality profile ────────────────────────────────────────────────
  //
  // The name is duplicated from the *registry* rather than read from it. The
  // registry row is what routes a request to this schema and is owned by
  // whoever provisions municipalities; this is what the municipality prints on
  // its own documents, and an administrator must be able to fix a misspelling
  // on their receipts without an operator editing the routing table.
  nameAr String?
  nameEn String?

  contactEmail String?
  website      String?

  /// Administrative location as it appears on official records. Free text, not
  /// a foreign key: Lebanon's caza boundaries are a political fact this system
  /// has no business asserting a canonical list of.
  governorate String?
  district    String?
  town        String?

  /// The crest, inlined.
  ///
  /// A data URI rather than a URL because this deployment has no object store
  /// to hold the file and nothing to serve it from. Capped at 512 KB by the
  /// schema on the way in, and deliberately excluded from the settings payload
  /// citizens receive — see `FeesService.getSettings`, which only includes it
  /// for staff. Returning half a megabyte of base64 on the pay dialog of every
  /// citizen on a 3G connection is the failure this avoids.
  logoDataUri String?

  // ── Finance defaults ────────────────────────────────────────────────────
  //
  // Every field here is a *default* applied when a fee is issued. Nothing
  // re-prices an existing debt: a CitizenPayment denormalises its own amount
  // precisely so that changing a rate cannot rewrite what a citizen already
  // owes.
  defaultFeeFrequency FeeFrequency @default(ANNUALLY)
  defaultDueDays      Int          @default(30)

  /// 'compact' | 'exact' — how large amounts render in tables and dashboards.
  priceDisplay String @default("compact")

  /// NUMERIC, not a float, even though the API hands it out as a JSON number:
  /// this multiplies money the moment an issuer reads it, and the database is
  /// the system of record for that. Anything computing a charge must read the
  /// Decimal, never round-trip through the JSON.
  defaultRatePercent Decimal @default(0) @db.Decimal(5, 2)

  baseCurrency      String  @default("LBP")
  secondaryCurrency String?

  /// Units of `baseCurrency` per one unit of `secondaryCurrency`. Six decimal
  /// places because the inverse of an LBP rate is a very small number.
  exchangeRate          Decimal?  @db.Decimal(18, 6)
  exchangeRateUpdatedAt DateTime?

  // ── Configuration held as documents ─────────────────────────────────────

  /// Per-document-type reference format: `{ invoice: { prefix, nextNumber,
  /// padding }, … }`.
  ///
  /// JSON rather than a table because nothing allocates a number from it yet.
  /// When an issuer does exist this must become its own table with a row per
  /// document type and `SELECT … FOR UPDATE` around the increment — a JSON
  /// blob cannot hand two concurrent requests two different invoice numbers,
  /// and silently issuing the same reference twice is exactly the failure a
  /// numbering scheme exists to prevent.
  numberingSequences Json?

  /// `{ frequency, timeOfDay, dayOfWeek, dayOfMonth, keepCopies }`. Read by
  /// nothing yet; there is no scheduler process in this deployment.
  backupSchedule Json?

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@map("system_settings")
}

enum FeeFrequency {
  ONCE
  MONTHLY
  HALF_YEARLY
  ANNUALLY
}

enum FeeTargetType {
  ALL_CITIZENS
  BUILDING_CATEGORY
  INDIVIDUAL_CITIZEN
}

enum PaymentStatus {
  UNPAID
  PENDING_REVIEW
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  WHISH_MONEY
  /// Cash, but taken by a محصّل on his round rather than at the counter.
  ///
  /// A separate value rather than CASH with a note, because the two differ in
  /// the one way that matters to a municipality reconciling a day: counter cash
  /// is already in the safe, collector cash is with a person until he hands it
  /// in. Folding them together makes "how much did we take today" and "how much
  /// do we hold" the same number, which they are not.
  COLLECTOR
}

/// What a notice's `amount` is *per*. See FeeBasis in the shared schemas.
enum FeeBasis {
  FLAT
  PER_UNIT
  PER_AREA
}

/// Who a fee is levied on — الرسم على الشاغل أم على المالك.
///
/// Lebanese practice draws this line and the register could not: a شاغرة unit
/// is relieved of رسوم الإشغال والنفايات and still owes الرسوم التأسيسية
/// كالأرصفة والمجاري. Those are not one fee with an exception; they are two
/// fees with different bearers, and this is which.
///
/// There is no third value meaning "charge everyone holding it". That was the
/// behaviour before this existed and it billed a landlord and their tenant for
/// the same flat — double taxation of one unit, which survived only because
/// nothing could tell the two apart.
enum FeeBearer {
  /// رسم النظافة, القيمة التأجيرية — on whoever is actually in the unit.
  OCCUPANT
  /// الأرصفة, المجاري — on the deed holder, whatever the unit's state.
  OWNER
}

/// The rule an administrator writes once: "500,000 LBP of رسم النفايات, every
/// month, for every resident". Issuing it fans out into one `CitizenPayment`
/// per matching citizen — this row is the template, never the debt.
model FeeNotice {
  id       String  @id @default(uuid()) @db.Uuid
  title    String
  /// Under FLAT this is the whole invoice. Under the other two it is a rate,
  /// and the register decides the total — see `FeesService.assessCitizen`.
  amount   Decimal @db.Decimal(14, 2)
  /// Defaulted so every notice written before per-unit billing existed keeps
  /// charging exactly what it always did.
  basis    FeeBasis @default(FLAT)
  /// Who owes this fee. See FeeBearer above and §12 of docs/open-decisions.md.
  ///
  /// OCCUPANT by default, which on a register where nobody has recorded
  /// حالة الوحدة yet is byte-for-byte the behaviour that came before it: an
  /// unmarked unit reads as occupied by its owner, so the owner is billed for
  /// all of them and each tenant for their own. Ignored under FLAT, where the
  /// amount does not depend on holdings at all.
  bearer FeeBearer @default(OCCUPANT)
  currency String  @default("LBP")

  frequency  FeeFrequency
  targetType FeeTargetType

  /// For BUILDING_CATEGORY: a `PropertyType` or `UnitType` value, kept as text
  /// because it spans two enums and neither owns the other.
  targetCategory  String?
  targetCitizenId String? @db.Uuid
  targetCitizen   User?   @relation("FeeTargetCitizen", fields: [targetCitizenId], references: [id])

  dueDate      DateTime
  /// Shown to the citizen above the payment options.
  instructions String?

  /// Whether the recurring biller still re-issues this notice each period.
  /// A recurring charge with no off switch would bill a municipality's
  /// residents forever; stopping it leaves every invoice already raised
  /// exactly as it stands.
  isActive Boolean @default(true)

  issuedById String? @db.Uuid
  issuedBy   User?   @relation("FeeIssuedBy", fields: [issuedById], references: [id])

  createdAt DateTime         @default(now())
  payments  CitizenPayment[]

  @@index([targetType])
  @@map("fee_notices")
}

/// One citizen's debt. Denormalises `title`/`amount` off the notice on purpose:
/// a clerk correcting next month's fee must not silently rewrite what someone
/// already paid last month.
model CitizenPayment {
  id        String @id @default(uuid()) @db.Uuid
  citizenId String @db.Uuid
  citizen   User   @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  /// Null for a one-off charge raised directly against a citizen.
  feeNoticeId String?    @db.Uuid
  feeNotice   FeeNotice? @relation(fields: [feeNoticeId], references: [id], onDelete: SetNull)

  title      String
  /// What the invoice was raised for. Never mutated on receipt — see paidAmount.
  amount     Decimal  @db.Decimal(14, 2)
  /// What has actually been received against it.
  ///
  /// Separate from `amount` so a partial payment is representable at all: a
  /// citizen paying half is `paidAmount < amount` with the row still UNPAID,
  /// rather than the clerk having to choose between refusing the money and
  /// marking a debt settled that is not. Reducing `amount` instead would erase
  /// what was originally owed and quietly change the answer of every report
  /// that sums it.
  paidAmount Decimal  @default(0) @db.Decimal(14, 2)
  currency   String   @default("LBP")
  dueDate    DateTime

  /// How this amount was arrived at, when it was not simply the notice's own.
  ///
  /// Written once, at issue, and never recomputed: a citizen who sells a shop
  /// the week after being billed would otherwise open an invoice whose lines no
  /// longer add up to what they are being asked to pay. A bill has to stay true
  /// to the moment it was raised. Null for a flat charge, which needs no
  /// explanation beyond its own amount.
  assessment Json?

  paymentStatus PaymentStatus  @default(UNPAID)
  paymentMethod PaymentMethod?

  /// What the citizen typed off their Whish receipt. Not verified by us — a
  /// clerk confirms it against the municipality's own account, which is the
  /// whole reason PENDING_REVIEW exists between UNPAID and PAID.
  whishTransactionRef String?
  receiptPath         String?

  paidAt       DateTime?
  reviewedById String?   @db.Uuid
  reviewedBy   User?     @relation("PaymentReviewedBy", fields: [reviewedById], references: [id])

  /// The محصّل who took the money, when `paymentMethod` is COLLECTOR.
  ///
  /// Distinct from `reviewedById`, which is whoever *typed* the row — usually a
  /// clerk at a desk entering what a collector handed in at the end of a round.
  /// Conflating the two would make "what does Hassan still hold" unanswerable,
  /// which is the only reason COLLECTOR exists as a method separate from CASH.
  collectedById String? @db.Uuid
  collectedBy   User?   @relation("PaymentCollectedBy", fields: [collectedById], references: [id])
  /// Why a clerk sent a claimed payment back to UNPAID.
  reviewNote    String?

  /// Which billing period this invoice covers: `2026-07`, `2026-H2`, `2026`,
  /// or `ONCE`. Written rather than derived so the uniqueness below is a
  /// database guarantee — the recurring job's safety against double-billing
  /// cannot depend on it remembering to check first.
  periodKey String @default("ONCE")

  /// Read-only, generated. The invoice's own searchable text — its title and
  /// the Whish reference — folded by the same rules as `User.searchText`, which
  /// see. The payer is reached through the join, not copied in here.
  searchText String?

  /// Whether a staff member has marked this pending verification notification as seen.
  isSeen Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Every movement of money against this invoice, oldest first.
  transactions PaymentTransaction[]

  /// One invoice per citizen, per notice, **per period**. Re-running July's
  /// billing is a no-op; August's is a new row. Without the period the
  /// monthly fee could only ever be charged once.
  @@unique([citizenId, feeNoticeId, periodKey])
  /// The portal's main read: this citizen's outstanding balance.
  @@index([citizenId, paymentStatus])
  /// The Whish callback matches on this; without an index it was a sequential
  /// scan over every payment in the municipality, on every webhook.
  @@index([whishTransactionRef])
  /// The admin queue: what is awaiting verification, oldest first.
  @@index([paymentStatus, dueDate])
  @@map("citizen_payments")
}

/// One movement of money against one invoice. Append-only.
///
/// The ledger `CitizenPayment` used to lack. That row keeps a *balance*:
/// `paidAmount` is a running total, `paymentMethod` is overwritten by each
/// settlement, and `whishTransactionRef` / `collectedById` are cleared when the
/// method changes. All of that is right for a balance and useless for a
/// history — a citizen who pays in three instalments leaves three receipts and
/// one row that remembers only the sum, so the second receipt cannot be
/// reprinted, a collector's day cannot be reconciled, and a refused transfer
/// takes its own reference with it.
///
/// `citizen_payments.paidAmount` is now a cache of SUM(amount) over these rows.
/// The rows are the truth; the column is what the ledger screens read without a
/// join.
///
/// Enforced append-only by trigger, exactly like `AuditLogEntry` and for the
/// same reason: a financial record the application can rewrite is worth only as
/// much as the application's good behaviour, which an auditor cannot verify.
model PaymentTransaction {
  id        String         @id @default(uuid()) @db.Uuid
  paymentId String         @db.Uuid
  payment   CitizenPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /// Signed: positive is money received, negative reverses an earlier entry.
  /// A correction is a new opposing row, never an edit — what happened stays on
  /// the record, and the correction is its own act with its own actor and time.
  amount   Decimal       @db.Decimal(14, 2)
  currency String        @default("LBP")
  method   PaymentMethod

  /// Printed on the receipt. Drawn from a Postgres sequence, so two clerks
  /// settling in the same moment cannot be handed the same number.
  receiptNumber String @unique

  /// The provider's handle, when the money came through Whish. Per transaction
  /// rather than per invoice, which is what makes a part-Whish, part-cash
  /// invoice describable at all.
  externalRef String?

  /// The collector holding the money, when `method` is COLLECTOR.
  collectedById String? @db.Uuid
  collectedBy   User?   @relation("TransactionCollectedBy", fields: [collectedById], references: [id], onDelete: Restrict)
  /// The staff member who entered the row — usually a clerk recording what a
  /// collector handed in at the end of a round.
  recordedById  String? @db.Uuid
  recordedBy    User?   @relation("TransactionRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  /// Set when this row reverses an earlier one. Unique, so an entry can be
  /// reversed at most once — twice would credit the citizen twice.
  reversalOfId String?             @unique @db.Uuid
  reversalOf   PaymentTransaction? @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy   PaymentTransaction? @relation("Reversal")

  note String?

  /// When the money moved, which is not always when the row was written: a
  /// collector's round is entered at the end of the day.
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  /// The receipt history for one invoice.
  @@index([paymentId, occurredAt])
  /// End-of-day reconciliation: what did this collector take, and when.
  @@index([collectedById, occurredAt])
  /// What the municipality took today, across every collector and clerk.
  @@index([occurredAt])
  @@map("payment_transactions")
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

/// Commission payouts recorded for Field Inspectors ($1 per registered property).
model InspectorPayout {
  id           String   @id @default(uuid()) @db.Uuid
  inspectorId  String   @db.Uuid
  inspector    User     @relation("InspectorPayouts", fields: [inspectorId], references: [id], onDelete: Cascade)
  amount       Decimal  @db.Decimal(10, 2)
  currency     String   @default("USD")
  paidAt       DateTime @default(now())
  note         String?
  reference    String?
  recordedById String?  @db.Uuid
  recordedBy   User?    @relation("RecordedInspectorPayouts", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([inspectorId, paidAt])
  @@map("inspector_payouts")
}


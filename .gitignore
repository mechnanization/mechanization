node_modules/
dist/
build/
.next/
# `pnpm build:check` — a verification build kept out of the dev server's
# `.next`, which the two would otherwise share and corrupt.
.next-check/
.turbo/
/coverage/
apps/*/coverage/
*.tsbuildinfo

# env — never commit real credentials.
#
# The wildcard matters more than it looks: .env.staging and .env.production
# hold live database passwords and service-role keys, and neither was covered
# by the old three-line list. Anything .env.* is ignored; only the *.example
# templates are re-admitted.
.env
.env.*
!.env.example
!.env.*.example

# Generated Prisma clients — two of them, one per schema kind. Regenerate with
# `pnpm db:generate`; they are build output, not source.
apps/backend/src/generated/

# Database dumps. These hold citizens' names, phone numbers and identity
# document numbers — never in git.
apps/backend/backups/*.json

.DS_Store
*.log
*.bundle
_to_delete/
.agents/
supabase/.temp/

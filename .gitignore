node_modules/
dist/
build/
.next/
# `pnpm build:check` — a verification build kept out of the dev server's
# `.next`, which the two would otherwise share and corrupt.
.next-check/
.turbo/
/coverage/
apps/*/coverage/
*.tsbuildinfo

# env — never commit real credentials.
#
# The wildcard matters more than it looks: .env.staging and .env.production
# hold live database passwords and service-role keys, and neither was covered
# by the old three-line list. Anything .env.* is ignored; only the *.example
# templates are re-admitted.
.env
.env.*
!.env.example
!.env.*.example

# Backup encryption keys — the other half of the credentials above, and the
# one with no way back.
#
# `age` encrypts the nightly production dump to a public key. Only the matching
# AGE-SECRET-KEY can read it, and there is no recovery path: lose the secret
# and every backup ever taken becomes permanently unreadable, while committing
# it hands whoever clones this repository every citizen record the backups
# hold. Both failures are silent until the day of a restore.
#
# Added because a `backup-key.txt` holding an AGE-SECRET-KEY was sitting
# untracked in the repository root, one `git add -A` from being pushed.
# The secret key belongs in a password manager, offline, and *not* in the same
# place as the dumps it decrypts.
backup-key.txt
*.age
*.agekey
age-key*.txt

# Generated Prisma clients — two of them, one per schema kind. Regenerate with
# `pnpm db:generate`; they are build output, not source.
apps/backend/src/generated/

# Database dumps. These hold citizens' names, phone numbers and identity
# document numbers — never in git.
apps/backend/backups/*.json

.DS_Store
*.log
*.bundle
_to_delete/
.agents/
supabase/.temp/

/graphify-out/cache/*